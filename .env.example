# ── Server ──
PORT=8000
LOG_LEVEL=info

# ── Trading Mode: "paper" (no wallet needed), "testnet", or "mainnet" ──
TRADING_MODE=paper

# ── Paper trading config (only used when TRADING_MODE=paper) ──
PAPER_BALANCE=10000
PAPER_PRICE_SOURCE=mainnet

# ── Hyperliquid config (only used when TRADING_MODE=testnet or mainnet) ──
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_NETWORK=testnet
VAULT_ADDRESS=

# ── Auth / JWT ──
JWT_SECRET_KEY=open-algotrade-secret-key-change-in-production

# ── Database (SQLite) ──
# Leave DATABASE_URL UNSET in production. Railway env var
# DATABASE_URL=sqlite:////data/sql_app.db points the DB at the persistent
# volume. Previously this file shipped DATABASE_URL=sqlite:///./sql_app.db
# which load_dotenv() injected into the container at /app (ephemeral) —
# every redeploy wiped the strategy DB. DO NOT re-add the line.
# DATABASE_URL=sqlite:///./sql_app.db  # historical — caused ephemeral-DB bug 2026-05-14/15

# ── Stripe (optional, for billing/subscriptions) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Solana DEX Scanner (optional) ──
SOLANA_SCANNER_ENABLED=true
BIRDEYE_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── CORS (comma-separated allowed origins for production) ──
CORS_ORIGINS=https://open-algotrade-v3.netlify.app,http://localhost:3000
